@model IEnumerable<axciom.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Activity Management";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-calendar-check-fill text-primary me-2"></i> Follow-Up Activity Scheduler</h3>
        <p class="text-muted small mb-0">Schedule calls, meetings, emails, and tasks. Track upcoming, completed, and overdue activities.</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="@Url.Action("Create")" class="btn btn-primary fw-semibold shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Schedule Follow-Up
        </a>
    </div>
</div>

<!-- Search & Filter Controls -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search subject, customer, lead..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="">-- All Statuses --</option>
                    <option value="Planned" selected="@(ViewBag.StatusFilter == "Planned")">Planned</option>
                    <option value="Completed" selected="@(ViewBag.StatusFilter == "Completed")">Completed</option>
                    <option value="Missed" selected="@(ViewBag.StatusFilter == "Missed")">Missed</option>
                    <option value="Cancelled" selected="@(ViewBag.StatusFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary px-3 fw-semibold"><i class="bi bi-funnel-fill me-1"></i> Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary px-3">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- FollowUp Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date & Time</th>
                    <th>Subject</th>
                    <th>Type</th>
                    <th>Related Customer / Lead</th>
                    <th>Assigned User</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                            No follow-up activities scheduled.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var isOverdue = item.Status == "Planned" && item.FollowUpDate.Date < DateTime.Today;
                        <tr>
                            <td class="small fw-semibold">
                                @item.FollowUpDate.ToString("MMM dd, yyyy")
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger ms-1">Overdue</span>
                                }
                            </td>
                            <td class="fw-semibold">@item.Subject</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @if (item.FollowUpType == "Call") { <i class="bi bi-telephone-fill me-1 text-primary"></i> }
                                    else if (item.FollowUpType == "Meeting") { <i class="bi bi-people-fill me-1 text-success"></i> }
                                    else if (item.FollowUpType == "Email") { <i class="bi bi-envelope-fill me-1 text-warning"></i> }
                                    else { <i class="bi bi-check2-square me-1 text-info"></i> }
                                    @item.FollowUpType
                                </span>
                            </td>
                            <td class="small">
                                @if (item.Customer != null)
                                {
                                    <span class="text-primary fw-semibold"><i class="bi bi-building me-1"></i> @item.Customer.CustomerName</span>
                                }
                                else if (item.Lead != null)
                                {
                                    <span class="text-secondary fw-semibold"><i class="bi bi-person me-1"></i> @item.Lead.LeadName</span>
                                }
                                else
                                {
                                    <span class="text-muted">General</span>
                                }
                            </td>
                            <td class="small">@(item.AssignedUser?.FullName ?? "Unassigned")</td>
                            <td>
                                @if (item.Status == "Completed")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle-fill me-1"></i> Completed</span>
                                }
                                else if (item.Status == "Missed" || isOverdue)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Missed / Overdue</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Planned</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (item.Status == "Planned")
                                    {
                                        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#completeModal-@item.FollowUpId" title="Mark Completed"><i class="bi bi-check-lg me-1"></i> Complete</button>
                                    }
                                    <a href="@Url.Action("Edit", new { id = item.FollowUpId })" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.FollowUpId" title="Delete"><i class="bi bi-trash"></i></button>
                                </div>

                                <!-- Complete Modal -->
                                <div class="modal fade text-start" id="completeModal-@item.FollowUpId" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-bold text-success"><i class="bi bi-check-circle-fill me-2"></i> Complete Follow-Up</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form asp-action="Complete" asp-route-id="@item.FollowUpId" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-body">
                                                    <p>Mark <strong>@item.Subject</strong> as completed.</p>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">Activity Completion Remarks</label>
                                                        <textarea name="remarks" class="form-control" rows="2" placeholder="Outcome notes or next actions..."></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-success">Save & Complete</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade text-start" id="deleteModal-@item.FollowUpId" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Follow-Up</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to delete follow-up <strong>@item.Subject</strong>?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="Delete" asp-route-id="@item.FollowUpId" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
