@{
    ViewData["Title"] = "CRM Reports & Export";
    string reportType = ViewBag.ReportType ?? "Pipeline";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-graph-up-arrow text-primary me-2"></i> CRM Analytical Reports</h3>
        <p class="text-muted small mb-0">Role-scoped reports with filters, pipeline weighting, lead conversion analytics, and CSV export.</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="@Url.Action("ExportCsv", new { reportType = reportType })" class="btn btn-success fw-semibold shadow-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export @reportType Report (CSV)
        </a>
    </div>
</div>

<!-- Report Navigation Tabs -->
<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <a href="@Url.Action("Index", new { reportType = "Pipeline" })" class="nav-link @(reportType == "Pipeline" ? "active" : "") fw-semibold">
            <i class="bi bi-funnel me-1"></i> Pipeline Report
        </a>
    </li>
    <li class="nav-item">
        <a href="@Url.Action("Index", new { reportType = "Customer" })" class="nav-link @(reportType == "Customer" ? "active" : "") fw-semibold">
            <i class="bi bi-building me-1"></i> Customer Report
        </a>
    </li>
    <li class="nav-item">
        <a href="@Url.Action("Index", new { reportType = "Lead" })" class="nav-link @(reportType == "Lead" ? "active" : "") fw-semibold">
            <i class="bi bi-person-lines-fill me-1"></i> Lead Report
        </a>
    </li>
    <li class="nav-item">
        <a href="@Url.Action("Index", new { reportType = "FollowUp" })" class="nav-link @(reportType == "FollowUp" ? "active" : "") fw-semibold">
            <i class="bi bi-calendar-check me-1"></i> Follow-Up Report
        </a>
    </li>
    <li class="nav-item">
        <a href="@Url.Action("Index", new { reportType = "Conversion" })" class="nav-link @(reportType == "Conversion" ? "active" : "") fw-semibold">
            <i class="bi bi-arrow-repeat me-1"></i> Lead Conversion Report
        </a>
    </li>
</ul>

<!-- Report Output Container -->
@if (reportType == "Conversion")
{
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 text-center">
                <span class="text-muted small fw-semibold">Total Leads Captured</span>
                <h2 class="fw-bold text-dark my-2">@ViewBag.TotalLeads</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 text-center bg-success-subtle">
                <span class="text-success small fw-semibold">Successfully Converted</span>
                <h2 class="fw-bold text-success my-2">@ViewBag.ConvertedCount</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 text-center bg-danger-subtle">
                <span class="text-danger small fw-semibold">Lost / Disqualified</span>
                <h2 class="fw-bold text-danger my-2">@ViewBag.LostCount</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 text-center bg-primary-subtle">
                <span class="text-primary small fw-semibold">Conversion Rate</span>
                <h2 class="fw-bold text-primary my-2">@(((double)ViewBag.ConversionRate).ToString("F1"))%</h2>
            </div>
        </div>
    </div>
}
else if (reportType == "Pipeline")
{
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-3 border-start border-4 border-primary">
                <span class="text-muted small fw-semibold">Total Open Pipeline Value</span>
                <h3 class="fw-bold text-primary my-1">@(((decimal)ViewBag.TotalPipeline).ToString("C0"))</h3>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-3 border-start border-4 border-success">
                <span class="text-muted small fw-semibold">Weighted Pipeline (Amount × Probability / 100)</span>
                <h3 class="fw-bold text-success my-1">@(((decimal)ViewBag.WeightedPipeline).ToString("C0"))</h3>
            </div>
        </div>
    </div>
}

<!-- Data Grid -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                @if (reportType == "Customer")
                {
                    <tr>
                        <th>Code</th>
                        <th>Customer Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Company</th>
                        <th>Owner</th>
                        <th>Created Date</th>
                    </tr>
                }
                else if (reportType == "Lead")
                {
                    <tr>
                        <th>Code</th>
                        <th>Lead Name</th>
                        <th>Email</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Expected Value</th>
                        <th>Owner</th>
                    </tr>
                }
                else if (reportType == "FollowUp")
                {
                    <tr>
                        <th>Follow-Up Date</th>
                        <th>Subject</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Assigned User</th>
                    </tr>
                }
                else
                {
                    <tr>
                        <th>Opportunity Name</th>
                        <th>Customer</th>
                        <th>Stage</th>
                        <th>Amount</th>
                        <th>Probability</th>
                        <th>Weighted Value</th>
                        <th>Expected Close</th>
                        <th>Owner</th>
                    </tr>
                }
            </thead>
            <tbody>
                @if (ViewBag.Data != null)
                {
                    @if (reportType == "Customer")
                    {
                        @foreach (var c in (List<axciom.Models.Customer>)ViewBag.Data)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark font-monospace">@c.CustomerCode</span></td>
                                <td class="fw-semibold">@c.CustomerName</td>
                                <td>@c.Email</td>
                                <td>@c.Phone</td>
                                <td>@c.CompanyName</td>
                                <td>@(c.Owner?.FullName ?? "Unassigned")</td>
                                <td class="small text-muted">@c.CreatedDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    }
                    else if (reportType == "Lead")
                    {
                        @foreach (var l in (List<axciom.Models.Lead>)ViewBag.Data)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark font-monospace">@l.LeadCode</span></td>
                                <td class="fw-semibold">@l.LeadName</td>
                                <td>@l.Email</td>
                                <td><span class="badge bg-light text-dark">@l.Source</span></td>
                                <td><span class="badge bg-primary-subtle text-primary">@l.Status</span></td>
                                <td class="fw-bold text-success">@l.ExpectedValue.ToString("C0")</td>
                                <td>@(l.Owner?.FullName ?? "Unassigned")</td>
                            </tr>
                        }
                    }
                    else if (reportType == "FollowUp")
                    {
                        @foreach (var f in (List<axciom.Models.FollowUp>)ViewBag.Data)
                        {
                            <tr>
                                <td class="small fw-semibold">@f.FollowUpDate.ToString("yyyy-MM-dd")</td>
                                <td class="fw-semibold">@f.Subject</td>
                                <td><span class="badge bg-light text-dark">@f.FollowUpType</span></td>
                                <td><span class="badge bg-secondary">@f.Status</span></td>
                                <td>@(f.AssignedUser?.FullName ?? "Unassigned")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        @foreach (var o in (List<axciom.Models.Opportunity>)ViewBag.Data)
                        {
                            <tr>
                                <td class="fw-semibold">@o.OpportunityName</td>
                                <td>@(o.Customer?.CustomerName ?? "N/A")</td>
                                <td><span class="badge bg-info-subtle text-info">@o.Stage</span></td>
                                <td class="fw-bold text-dark">@o.Amount.ToString("C0")</td>
                                <td>@o.Probability%</td>
                                <td class="fw-bold text-success">@o.WeightedPipeline.ToString("C0")</td>
                                <td class="small">@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                <td>@(o.Owner?.FullName ?? "Unassigned")</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>
