@using Microsoft.AspNetCore.Identity
@using axciom.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --primary-bg: #0f172a;
            --accent-color: #3b82f6;
            --sidebar-width: 250px;
        }
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        .app-header {
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            height: 64px;
            z-index: 1020;
        }
        .sidebar {
            width: var(--sidebar-width);
            background-color: #0f172a;
            color: #94a3b8;
            min-height: calc(100vh - 64px);
            transition: all 0.3s;
        }
        .sidebar .nav-link {
            color: #94a3b8;
            padding: 0.75rem 1.25rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            border-radius: 0.375rem;
            margin: 0.2rem 0.75rem;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.1);
        }
        .sidebar .nav-link i {
            font-size: 1.15rem;
        }
        .sidebar .sidebar-heading {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 1rem 1.25rem 0.5rem;
            color: #64748b;
            font-weight: 700;
        }
        .main-content {
            flex: 1;
            padding: 2rem;
            min-height: calc(100vh - 64px);
        }
        .card {
            border: 1px solid #e2e8f0;
            border-radius: 0.75rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        }
        .badge-role {
            font-size: 0.75rem;
            padding: 0.35em 0.65em;
            border-radius: 20px;
        }
        .field-validation-error {
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 0.25rem;
            display: block;
        }
    </style>
</head>
<body>

    <!-- Header Navigation -->
    <header class="app-header navbar navbar-expand-lg sticky-top shadow-sm px-3">
        <div class="container-fluid p-0">
            <a class="navbar-brand d-flex align-items-center gap-2 font-monospace fw-bold text-primary fs-4" href="@Url.Action("Index", "Dashboard")">
                <i class="bi bi-rocket-takeoff-fill"></i> AcxiomCRM
            </a>

            @if (SignInManager.IsSignedIn(User))
            {
                var currentUser = await UserManager.GetUserAsync(User);
                var roles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
                var primaryRole = roles.FirstOrDefault() ?? "SalesExecutive";

                <div class="d-flex align-items-center ms-auto gap-3">
                    <!-- Global Search Quick Input -->
                    <div class="d-none d-md-block position-relative" style="width: 250px;">
                        <input type="text" class="form-control form-control-sm ps-4 bg-light border-0" placeholder="Search CRM..." />
                        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted fs-6"></i>
                    </div>

                    <!-- User Menu Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-light btn-sm dropdown-toggle d-flex align-items-center gap-2 border-0" type="button" data-bs-toggle="dropdown">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px;">
                                @(currentUser?.FullName?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <div class="text-start d-none d-sm-block">
                                <div class="fw-semibold lh-1" style="font-size: 0.85rem;">@currentUser?.FullName</div>
                                <span class="badge bg-secondary badge-role mt-1">@primaryRole</span>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                            <li class="dropdown-header">Logged in as <strong>@currentUser?.Email</strong></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Dashboard")"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a></li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Users")"><i class="bi bi-people me-2"></i> User Administration</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "AuditLogs")"><i class="bi bi-journal-text me-2"></i> System Audit Logs</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i> Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            }
        </div>
    </header>

    <div class="d-flex">
        @if (SignInManager.IsSignedIn(User))
        {
            <!-- Sidebar Navigation -->
            <nav class="sidebar flex-shrink-0 d-none d-md-block">
                <div class="py-3">
                    <div class="sidebar-heading">Main Overview</div>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" href="@Url.Action("Index", "Dashboard")">
                                <i class="bi bi-grid-1x2-fill"></i> Dashboard
                            </a>
                        </li>
                    </ul>

                    <div class="sidebar-heading">Sales Lifecycle</div>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")" href="@Url.Action("Index", "Customers")">
                                <i class="bi bi-building"></i> Customers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leads" ? "active" : "")" href="@Url.Action("Index", "Leads")">
                                <i class="bi bi-person-lines-fill"></i> Leads
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Opportunities" ? "active" : "")" href="@Url.Action("Index", "Opportunities")">
                                <i class="bi bi-briefcase-fill"></i> Opportunities
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FollowUps" ? "active" : "")" href="@Url.Action("Index", "FollowUps")">
                                <i class="bi bi-calendar-check-fill"></i> Follow-Ups
                            </a>
                        </li>
                    </ul>

                    <div class="sidebar-heading">Analytics & Reports</div>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" href="@Url.Action("Index", "Reports")">
                                <i class="bi bi-graph-up-arrow"></i> Reports & Export
                            </a>
                        </li>
                    </ul>

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <div class="sidebar-heading">Governance & Security</div>
                        <ul class="nav flex-column">
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" href="@Url.Action("Index", "Users")">
                                        <i class="bi bi-shield-lock-fill"></i> Users & Roles
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLogs" ? "active" : "")" href="@Url.Action("Index", "AuditLogs")">
                                    <i class="bi bi-file-earmark-text-fill"></i> Audit Logs
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </nav>
        }

        <!-- Main Content Body -->
        <main class="main-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <!-- Bootstrap & jQuery Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
