@model axciom.Models.Customer
@{
    ViewData["Title"] = "Customer Profile - " + Model.CustomerName;
    var opportunities = ViewBag.Opportunities as List<axciom.Models.Opportunity> ?? new List<axciom.Models.Opportunity>();
    var followUps = ViewBag.FollowUps as List<axciom.Models.FollowUp> ?? new List<axciom.Models.FollowUp>();
}

<div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-person-badge text-primary me-2"></i> @Model.CustomerName</h3>
        <span class="badge bg-light text-dark font-monospace fs-6">@Model.CustomerCode</span>
        <span class="badge bg-success ms-2">@Model.Status</span>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Edit", new { id = Model.CustomerId })" class="btn btn-primary btn-sm"><i class="bi bi-pencil me-1"></i> Edit Profile</a>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
    </div>
</div>

<div class="row g-4">
    <!-- Profile Info Card -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-bold py-3">
                <i class="bi bi-info-circle me-1 text-primary"></i> Contact Information
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-0">
                        <span class="text-muted small d-block">Company Name</span>
                        <strong class="text-dark">@(string.IsNullOrEmpty(Model.CompanyName) ? "N/A" : Model.CompanyName)</strong>
                    </li>
                    <li class="list-group-item px-0">
                        <span class="text-muted small d-block">Email Address</span>
                        <a href="mailto:@Model.Email" class="text-decoration-none font-monospace">@Model.Email</a>
                    </li>
                    <li class="list-group-item px-0">
                        <span class="text-muted small d-block">Phone Number</span>
                        <span class="font-monospace fw-semibold">@Model.Phone</span>
                    </li>
                    <li class="list-group-item px-0">
                        <span class="text-muted small d-block">Address Location</span>
                        <span>@Model.Address, @Model.City, @Model.State</span>
                    </li>
                    <li class="list-group-item px-0">
                        <span class="text-muted small d-block">Assigned Account Manager</span>
                        <span class="badge bg-secondary badge-role mt-1"><i class="bi bi-person-fill me-1"></i> @(Model.Owner?.FullName ?? "Unassigned")</span>
                    </li>
                    <li class="list-group-item px-0">
                        <span class="text-muted small d-block">Member Since</span>
                        <span class="small">@Model.CreatedDate.ToString("MMMM dd, yyyy")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Related History Tabs -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-3 pb-0">
                <ul class="nav nav-tabs card-header-tabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-semibold" data-bs-toggle="tab" data-bs-target="#oppsTab">
                            <i class="bi bi-briefcase me-1"></i> Opportunities (@opportunities.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-semibold" data-bs-toggle="tab" data-bs-target="#followTab">
                            <i class="bi bi-calendar-check me-1"></i> Follow-Up Activities (@followUps.Count)
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body tab-content p-3">
                <!-- Opportunities Tab -->
                <div class="tab-pane fade show active" id="oppsTab">
                    @if (!opportunities.Any())
                    {
                        <div class="text-center py-4 text-muted">No opportunities logged for this customer.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Opportunity</th>
                                        <th>Amount</th>
                                        <th>Stage</th>
                                        <th>Close Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var opp in opportunities)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@opp.OpportunityName</td>
                                            <td class="text-success fw-bold">@opp.Amount.ToString("C0")</td>
                                            <td><span class="badge bg-info-subtle text-info">@opp.Stage</span></td>
                                            <td class="small">@opp.ExpectedCloseDate.ToString("MMM dd, yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- Follow-Ups Tab -->
                <div class="tab-pane fade" id="followTab">
                    @if (!followUps.Any())
                    {
                        <div class="text-center py-4 text-muted">No follow-ups recorded for this customer.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Subject</th>
                                        <th>Type</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in followUps)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@f.Subject</td>
                                            <td><span class="badge bg-light text-dark">@f.FollowUpType</span></td>
                                            <td class="small">@f.FollowUpDate.ToString("MMM dd, yyyy")</td>
                                            <td><span class="badge bg-secondary">@f.Status</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
