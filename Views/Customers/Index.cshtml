@model IEnumerable<axciom.Models.Customer>
@{
    ViewData["Title"] = "Customer Management";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-building text-primary me-2"></i> Customer Management</h3>
        <p class="text-muted small mb-0">Manage customer master data, contacts, owner assignments, and interaction history.</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="@Url.Action("Create")" class="btn btn-primary fw-semibold shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add New Customer
        </a>
    </div>
</div>

<!-- Search & Filter Controls -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search by name, email, phone, company..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="">-- All Statuses --</option>
                    <option value="Active" selected="@(ViewBag.StatusFilter == "Active")">Active</option>
                    <option value="Inactive" selected="@(ViewBag.StatusFilter == "Inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary px-3 fw-semibold"><i class="bi bi-funnel-fill me-1"></i> Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary px-3">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Customer Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Customer Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Company</th>
                    <th>Owner</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                            No customer records found matching your query.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark font-monospace">@item.CustomerCode</span></td>
                            <td class="fw-semibold">@item.CustomerName</td>
                            <td><a href="mailto:@item.Email" class="text-decoration-none">@item.Email</a></td>
                            <td>@item.Phone</td>
                            <td>@(string.IsNullOrEmpty(item.CompanyName) ? "-" : item.CompanyName)</td>
                            <td>
                                <span class="badge bg-secondary badge-role">
                                    <i class="bi bi-person-circle me-1"></i> @(item.Owner?.FullName ?? "Unassigned")
                                </span>
                            </td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
                                }
                            </td>
                            <td class="small text-muted">@item.CreatedDate.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="@Url.Action("Details", new { id = item.CustomerId })" class="btn btn-outline-secondary" title="View History"><i class="bi bi-eye"></i></a>
                                    <a href="@Url.Action("Edit", new { id = item.CustomerId })" class="btn btn-outline-primary" title="Edit Customer"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.CustomerId" title="Delete"><i class="bi bi-trash"></i></button>
                                </div>

                                <!-- Delete Confirmation Modal -->
                                <div class="modal fade text-start" id="deleteModal-@item.CustomerId" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Customer Deletion</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to delete customer <strong>@item.CustomerName</strong> (@item.CustomerCode)? This action will be recorded in the security audit trail.
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="Delete" asp-route-id="@item.CustomerId" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
