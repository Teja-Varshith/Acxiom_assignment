@model axciom.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - AcxiomCRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .login-card {
            background-color: #ffffff;
            border-radius: 1rem;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
            width: 100%;
            max-width: 440px;
            overflow: hidden;
        }
        .login-header {
            background-color: #0f172a;
            color: #ffffff;
            padding: 2.5rem 2rem 2rem;
            text-align: center;
        }
        .demo-chip {
            cursor: pointer;
            transition: all 0.2s;
        }
        .demo-chip:hover {
            transform: translateY(-2px);
        }
    </style>
</head>
<body>

<div class="login-card">
    <div class="login-header">
        <h2 class="fw-bold d-flex align-items-center justify-content-center gap-2 mb-1">
            <i class="bi bi-rocket-takeoff-fill text-primary"></i> AcxiomCRM
        </h2>
        <p class="text-muted small mb-0">Sign in to your sales workstation</p>
    </div>

    <div class="p-4">
        <!-- Demo Accounts Quick Fill -->
        <div class="mb-4 p-3 bg-light rounded-3 border">
            <label class="form-label text-muted fw-bold small text-uppercase mb-2" style="font-size: 0.7rem;">Quick Login Demo Roles:</label>
            <div class="d-flex flex-wrap gap-2">
                <span class="badge bg-danger demo-chip" onclick="fillDemo('admin@acxiom.com', 'Admin@1234')">
                    <i class="bi bi-shield-lock-fill me-1"></i> Admin
                </span>
                <span class="badge bg-primary demo-chip" onclick="fillDemo('manager@acxiom.com', 'Manager@1234')">
                    <i class="bi bi-briefcase-fill me-1"></i> Manager
                </span>
                <span class="badge bg-success demo-chip" onclick="fillDemo('sales@acxiom.com', 'Sales@1234')">
                    <i class="bi bi-person-fill me-1"></i> Sales Exec
                </span>
            </div>
        </div>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-medium small">Email Address / Username</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" id="emailInput" class="form-control" placeholder="user@acxiom.com" autocomplete="username" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-medium small">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" id="passwordInput" class="form-control" type="password" placeholder="••••••••" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label small text-muted">Remember my login session</label>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm">
                <i class="bi bi-box-arrow-in-right me-2"></i> Sign In to Account
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top">
            <span class="text-muted small">Need an account?</span>
            <a href="@Url.Action("Register", "Account")" class="small fw-semibold text-primary ms-1">Create Account</a>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
<script>
    function fillDemo(email, password) {
        document.getElementById('emailInput').value = email;
        document.getElementById('passwordInput').value = password;
    }
</script>
</body>
</html>
