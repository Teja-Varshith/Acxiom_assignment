@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card shadow border-0 mx-auto" style="max-width: 500px;">
        <div class="card-body p-5">
            <div class="text-danger display-1 mb-3">
                <i class="bi bi-shield-slash-fill"></i>
            </div>
            <h2 class="fw-bold text-dark">403 - Access Denied</h2>
            <p class="text-muted mt-2">
                You do not have permission to view or manipulate this resource. Your role scope restricts access to this page or record.
            </p>
            <div class="mt-4">
                <a href="@Url.Action("Index", "Dashboard")" class="btn btn-primary fw-semibold px-4">
                    <i class="bi bi-house-door-fill me-2"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
