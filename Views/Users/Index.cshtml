@model IEnumerable<axciom.ViewModels.UserItemViewModel>
@{
    ViewData["Title"] = "User & Role Administration";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-shield-lock-fill text-danger me-2"></i> User & Role Administration</h3>
        <p class="text-muted small mb-0">Manage user accounts, assign primary roles (Admin, Manager, SalesExecutive), view lockout status, and trigger security resets.</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="@Url.Action("Register", "Account")" class="btn btn-primary fw-semibold shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Register New User
        </a>
    </div>
</div>

<!-- Search Input -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search user name or email..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary px-3 fw-semibold"><i class="bi bi-funnel-fill me-1"></i> Search</button>
                <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary px-3">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- User List Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Full Name</th>
                    <th>Email Address</th>
                    <th>Role</th>
                    <th>Account Status</th>
                    <th>Lockout Status</th>
                    <th>Failed Attempts</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-semibold">@user.FullName</td>
                        <td><span class="font-monospace small">@user.Email</span></td>
                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span class="badge bg-danger"><i class="bi bi-shield-fill me-1"></i> Admin</span>
                            }
                            else if (user.Role == "Manager")
                            {
                                <span class="badge bg-primary"><i class="bi bi-briefcase-fill me-1"></i> Manager</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="bi bi-person-fill me-1"></i> Sales Executive</span>
                            }
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Deactivated</span>
                            }
                        </td>
                        <td>
                            @if (user.IsLockedOut)
                            {
                                <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i> Locked Out</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border"><i class="bi bi-unlock-fill me-1"></i> Normal</span>
                            }
                        </td>
                        <td><span class="badge bg-light text-dark font-monospace">@user.FailedLoginCount / 5</span></td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                @if (user.IsLockedOut)
                                {
                                    <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-warning fw-semibold" title="Unlock Account"><i class="bi bi-unlock-fill me-1"></i> Unlock</button>
                                    </form>
                                }

                                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#roleModal-@user.Id" title="Change Role"><i class="bi bi-person-gear"></i> Role</button>
                                <button type="button" class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#resetModal-@user.Id" title="Reset Password"><i class="bi bi-key-fill"></i> Reset</button>
                                
                                <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="Toggle Active Status">
                                        <i class="bi @(user.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                    </button>
                                </form>
                            </div>

                            <!-- Change Role Modal -->
                            <div class="modal fade text-start" id="roleModal-@user.Id" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title fw-bold"><i class="bi bi-person-gear me-2"></i> Change Primary Role</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-action="ChangeRole" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <div class="modal-body">
                                                <p class="small text-muted mb-2">Update primary authorization role for <strong>@user.Email</strong>:</p>
                                                <select name="newRole" class="form-select">
                                                    <option value="Admin" selected="@(user.Role == "Admin")">Admin (Full System Scope)</option>
                                                    <option value="Manager" selected="@(user.Role == "Manager")">Manager (Team Scope)</option>
                                                    <option value="SalesExecutive" selected="@(user.Role == "SalesExecutive")">Sales Executive (Sales Scope)</option>
                                                </select>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary fw-semibold">Save Role</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <!-- Password Reset Modal -->
                            <div class="modal fade text-start" id="resetModal-@user.Id" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title fw-bold"><i class="bi bi-key-fill me-2"></i> Admin Password Reset</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-action="ResetPassword" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <div class="modal-body">
                                                <p class="small text-muted mb-2">Set new password for <strong>@user.Email</strong>:</p>
                                                <input type="password" name="newPassword" class="form-control" placeholder="••••••••" required />
                                                <div class="form-text small mt-1">Must meet password policy (min 8 chars, mixed case, number, special char).</div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-dark fw-semibold">Reset Password</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
